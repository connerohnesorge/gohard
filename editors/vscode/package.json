{
  "name": "gohard",
  "displayName": "GoHard",
  "description": "VHDL language server: diagnostics, navigation, formatting, semantic tokens and testbench code lenses from gohard lsp.",
  "version": "2.0.0",
  "publisher": "connerohnesorge",
  "license": "MPL-2.0",
  "homepage": "https://github.com/connerohnesorge/gohard/blob/main/docs/editors.md#vs-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/connerohnesorge/gohard.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/connerohnesorge/gohard/issues"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "vhdl",
    "hdl",
    "fpga",
    "lsp",
    "simulation"
  ],
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you have not trusted, gohard.path comes only from your user settings.",
      "restrictedConfigurations": [
        "gohard.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": [
          "VHDL",
          "vhdl"
        ],
        "extensions": [
          ".vhd",
          ".vhdl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "signal",
        "superType": "variable",
        "description": "A VHDL signal."
      },
      {
        "id": "port",
        "superType": "parameter",
        "description": "A VHDL port."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "inactive",
        "description": "Code in an inactive conditional analysis branch."
      }
    ],
    "commands": [
      {
        "command": "gohard.restartServer",
        "title": "Restart Server",
        "category": "GoHard"
      },
      {
        "command": "gohard.showOutput",
        "title": "Show Output",
        "category": "GoHard"
      }
    ],
    "configuration": {
      "title": "GoHard",
      "properties": {
        "gohard.path": {
          "type": "string",
          "default": "gohard",
          "markdownDescription": "The `gohard` binary the extension starts as `gohard lsp`: a command on `PATH` or an absolute path. A change restarts the server."
        },
        "gohard.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the server to the GoHard output."
        },
        "gohard.inlay_hints.parameter_names": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the formal name before each positional actual of a subprogram call, generic map or port map."
        },
        "gohard.inlay_hints.types": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the type of an object alias declared without a subtype indication and of a loop parameter."
        },
        "gohard.inlay_hints.values": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the static value of a constant or a generic default when static evaluation succeeds within the editor's limit of 1,000,000 steps, which the values of one request share in source order."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test \"out/test/unit/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0",
    "typescript": "~6.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign": false
  }
}
