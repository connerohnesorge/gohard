[]byte("-- gc_heap: design under test for the gc_heap corpus design (#27).\n-- A queue of integers held in a linked list of access-type nodes.\n-- A pop drops the head node without DEALLOCATE: under VHDL-2019 the\n-- simulator's garbage collector reclaims it.\nlibrary ieee;\nuse ieee.std_logic_1164.all;\n\nentity gc_heap is\n  port (\n    clk   : in  std_logic;\n    push  : in  std_logic;\n    pop   : in  std_logic;\n    din   : in  integer;\n    dout  : out integer;\n    count : out natural\n  );\nend entity gc_heap;\n\narchitecture behav of gc_heap is\nbegin\n  queue : process (clk)\n    type node;\n    type node_ptr is access node;\n    type node is record\n      value : integer;\n      link  : node_ptr;\n    end record;\n    variable head, tail : node_ptr;\n    variable n : natural := 0;\n  begin\n    if rising_edge(clk) then\n      if pop = '1' and head /= null then\n        dout <= head.value;\n        head := head.link; -- the old head is garbage now\n        if head = null then\n          tail := null;\n        end if;\n        n := n - 1;\n      end if;\n      if push = '1' then\n        if tail = null then\n          tail := new node'(din, null);\n          head := tail;\n        else\n          tail.link := new node'(din, null);\n          tail := tail.link;\n        end if;\n        n := n + 1;\n      end if;\n      count <= n;\n    end if;\n  end process queue;\nend architecture behav;\n")
