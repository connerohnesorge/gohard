[]byte("-- psl_comments_tb: drives the clock and stops with std.env.finish at\n-- 100 ns. The outcome is decided by the `-- psl` directives in\n-- psl_comments.\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\n\nentity psl_comments_tb is\nend entity psl_comments_tb;\n\narchitecture sim of psl_comments_tb is\n  signal clk : std_logic := '0';\n  signal a   : std_logic;\n  signal b   : std_logic;\nbegin\n  clk <= not clk after 5 ns;\n\n  dut : entity work.psl_comments\n    port map (clk => clk, a => a, b => b);\n\n  stopper : process\n  begin\n    wait for 100 ns;\n    finish;\n  end process stopper;\nend architecture sim;\n")
