[]byte("-- budget_hang: design under test for the budget_hang corpus design (#8).\n-- A free-running 8-bit counter with a synchronous reset.\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity budget_hang is\n  port (\n    clk   : in  std_logic;\n    rst   : in  std_logic;\n    count : out unsigned(7 downto 0)\n  );\nend entity budget_hang;\n\narchitecture rtl of budget_hang is\n  signal q : unsigned(7 downto 0) := (others => '0');\nbegin\n  count <= q;\n\n  tick : process (clk)\n  begin\n    if rising_edge(clk) then\n      if rst = '1' then\n        q <= (others => '0');\n      else\n        q <= q + 1;\n      end if;\n    end if;\n  end process tick;\nend architecture rtl;\n")
