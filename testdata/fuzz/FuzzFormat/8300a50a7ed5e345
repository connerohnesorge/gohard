[]byte("-- crypt_core_model: plain VHDL stand-in for the opaque work.crypt_core\n-- (simulation.models). Same entity and ports as crypt_core.vhd. Behaviour:\n-- one clock after din is sampled, dout = din xor x\"5A\" and valid = '1';\n-- reset clears both.\nlibrary ieee;\nuse ieee.std_logic_1164.all;\n\nentity crypt_core is\n  port (\n    clk   : in  std_logic;\n    rst   : in  std_logic;\n    din   : in  std_logic_vector(7 downto 0);\n    dout  : out std_logic_vector(7 downto 0);\n    valid : out std_logic\n  );\nend entity crypt_core;\n\narchitecture model of crypt_core is\nbegin\n  process (clk)\n  begin\n    if rising_edge(clk) then\n      if rst = '1' then\n        dout  <= (others => '0');\n        valid <= '0';\n      else\n        dout  <= din xor x\"5A\";\n        valid <= '1';\n      end if;\n    end if;\n  end process;\nend architecture model;\n")
