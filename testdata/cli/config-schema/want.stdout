{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/connerohnesorge/gohard/main/schema/gohard.schema.json",
  "title": "gohard.yaml",
  "description": "GoHard project configuration (#28). Generated by tools/genconfig; do not edit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "standard": {
      "description": "The VHDL standard files are analyzed under. It must be a quoted string: `standard: \"2008\"`.",
      "type": "string",
      "enum": ["1993", "2002", "2008", "2019"],
      "default": "2008"
    },
    "lenient": {
      "description": "Relax analysis rules that other VHDL tools commonly relax.",
      "type": "boolean",
      "default": false
    },
    "psl": {
      "description": "PSL parsing.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "comments": {
          "description": "Parse `-- psl` comment lines as PSL.",
          "type": "boolean",
          "default": false
        },
        "strict_keywords": {
          "description": "Report PSL-only words used as identifiers as errors (GHDL-style).",
          "type": "boolean",
          "default": false
        }
      }
    },
    "libraries": {
      "description": "Maps each library name to the folders holding its sources, relative to the project root. Files in no listed folder go to `work`. A missing or unreadable folder is a setup error (exit 2).",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z](_?[A-Za-z0-9])*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": ["string", "number"],
          "minLength": 1
        }
      },
      "default": {}
    },
    "allow_opaque": {
      "description": "Encrypted units that may stay opaque. It downgrades encrypted IP only; unsupported constructs stay exit 2. `gohard libs detect --write` fills it in.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z](_?[A-Za-z0-9])*\\.[A-Za-z](_?[A-Za-z0-9])*$"
      },
      "default": []
    },
    "defines": {
      "description": "User conditional-analysis identifiers. `--define NAME=VALUE` overrides an entry with the same name. Defining a built-in identifier (`VHDL_VERSION`, `TOOL_TYPE`, `TOOL_VENDOR`, `TOOL_NAME`, `TOOL_EDITION`, `TOOL_VERSION`) is a setup error (exit 2).",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z](_?[A-Za-z0-9])*$",
        "not": {
          "pattern": "^([tT][oO][oO][lL]_[eE][dD][iI][tT][iI][oO][nN]|[tT][oO][oO][lL]_[nN][aA][mM][eE]|[tT][oO][oO][lL]_[tT][yY][pP][eE]|[tT][oO][oO][lL]_[vV][eE][nN][dD][oO][rR]|[tT][oO][oO][lL]_[vV][eE][rR][sS][iI][oO][nN]|[vV][hH][dD][lL]_[vV][eE][rR][sS][iI][oO][nN])$"
        }
      },
      "additionalProperties": {
        "type": ["string", "number"]
      },
      "default": {}
    },
    "format": {
      "description": "The formatter (`gohard fmt`, #32).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "indent": {
          "description": "Spaces per indentation level.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807,
          "default": 2
        },
        "keyword_case": {
          "description": "Case of reserved words.",
          "type": "string",
          "enum": ["lower", "upper", "preserve"],
          "default": "lower"
        },
        "align_ports": {
          "description": "Align port, generic and association lists.",
          "type": "boolean",
          "default": true
        },
        "max_line_length": {
          "description": "Lines longer than this are wrapped.",
          "type": "integer",
          "minimum": 40,
          "maximum": 9223372036854775807,
          "default": 80
        }
      }
    },
    "simulation": {
      "description": "Elaboration and simulation (#35).",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "auto_run_on_save": {
          "description": "When on, testbench candidates whose dependencies changed run after a short debounce on save. The code lens and the CLI always run.",
          "type": "boolean",
          "default": false
        },
        "testbenches": {
          "description": "Entities to treat as testbenches, in addition to every entity without ports.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z](_?[A-Za-z0-9])*$"
          },
          "default": []
        },
        "seed": {
          "description": "The simulation seed: it fixes the in-delta process order. 0 keeps declaration order.",
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "default": 0
        },
        "time_budget": {
          "description": "Simulated time after which a run stops with `sim/budget-exceeded`.",
          "type": "string",
          "pattern": "^[0-9](_?[0-9])*(\\.[0-9](_?[0-9])*)?([eE][+-]?[0-9](_?[0-9])*)? +([fF][sS]|[pP][sS]|[nN][sS]|[uU][sS]|[mM][sS]|[sS][eE][cC]|[mM][iI][nN]|[hH][rR])$",
          "default": "1 ms"
        },
        "delta_budget": {
          "description": "Delta cycles allowed per time step.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807,
          "default": 10000
        },
        "step_budget": {
          "description": "Kernel steps allowed per run.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807,
          "default": 50000000
        },
        "stop_level": {
          "description": "The assertion severity that stops a run. It does not change severities or exit codes.",
          "type": "string",
          "enum": ["note", "warning", "error", "failure"],
          "default": "error"
        },
        "dump_scope": {
          "description": "Only signals under these instance paths are traced. Empty traces every signal. Traces always go to `.gohard/traces/`.",
          "type": "array",
          "items": {
            "type": ["string", "number"],
            "minLength": 1
          },
          "default": []
        },
        "models": {
          "description": "Maps an opaque unit to the user's own plain VHDL model. GoHard checks that the stand-in's ports match the real component's.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z](_?[A-Za-z0-9])*\\.[A-Za-z](_?[A-Za-z0-9])*$"
          },
          "additionalProperties": {
            "type": ["string", "number"],
            "minLength": 1
          },
          "default": {}
        },
        "env": {
          "description": "The deterministic `std.env` environment (v1.1).",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "description": "The fixed wall-clock time `std.env` reports. Validated in v1.0, used from v1.1.",
              "type": "string",
              "format": "date-time",
              "pattern": "[Zz]$",
              "default": "2000-01-01T00:00:00Z"
            },
            "vars": {
              "description": "The only variables `GETENV` sees. Validated in v1.0, used from v1.1.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[^=\\x00]+$"
              },
              "additionalProperties": {
                "type": ["string", "number"]
              },
              "default": {}
            }
          }
        }
      }
    }
  }
}
