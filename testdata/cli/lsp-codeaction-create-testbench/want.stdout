{"title":"Create testbench counter_tb.vhd","kind":"source","edit":{"documentChanges":[{"kind":"create","uri":"file://$WORK/counter_tb.vhd"},{"textDocument":{"uri":"file://$WORK/counter_tb.vhd","version":null},"edits":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}},"newText":"library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity counter_tb is\nend entity counter_tb;\n\narchitecture sim of counter_tb is\n  constant WIDTH : positive := 8;\n  constant CLK_PERIOD : time := 10 ns;\n  signal clk : std_logic;\n  signal rst : std_logic;\n  signal en : std_logic := '1';\n  signal count : unsigned(WIDTH - 1 downto 0);\nbegin\n  u_counter : entity work.counter\n    generic map (\n      WIDTH => WIDTH\n    )\n    port map (\n      clk   => clk,\n      rst   => rst,\n      en    => en,\n      count => count\n    );\n\n  clk_gen : process\n  begin\n    clk <= '0';\n    wait for CLK_PERIOD / 2;\n    clk <= '1';\n    wait for CLK_PERIOD / 2;\n  end process clk_gen;\n\n  stimulus : process\n  begin\n    wait for 100 * CLK_PERIOD;\n    std.env.finish;\n  end process stimulus;\nend architecture sim;\n"}]}]}}
