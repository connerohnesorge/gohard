{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gohard",
          "version": "0.0.0-dev",
          "informationUri": "https://github.com/connerohnesorge/gohard",
          "rules": [
            {
              "id": "config/bad-bool",
              "shortDescription": {
                "text": "a bool key holds something other than true or false"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/bad-time",
              "shortDescription": {
                "text": "a malformed VHDL time string"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/bad-timestamp",
              "shortDescription": {
                "text": "a malformed RFC 3339 UTC time"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/builtin-define",
              "shortDescription": {
                "text": "a built-in conditional-analysis identifier is defined"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/duplicate-key",
              "shortDescription": {
                "text": "a key appears twice in one mapping"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/enum",
              "shortDescription": {
                "text": "a value outside the key's allowed set"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/range",
              "shortDescription": {
                "text": "a number outside the key's range"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/unknown-key",
              "shortDescription": {
                "text": "a key that gohard.yaml does not define"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/unquoted-bool",
              "shortDescription": {
                "text": "an unquoted YAML 1.1 boolean in a string key"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "config/unquoted-standard",
              "shortDescription": {
                "text": "standard is an unquoted number"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false,
