{"title":"Declare component counter","kind":"refactor.rewrite","edit":{"changes":{"file://$WORK/top.vhd":[{"range":{"start":{"line":15,"character":41},"end":{"line":15,"character":41}},"newText":"\n\n  component counter is\n    generic (\n      WIDTH : positive := 8\n    );\n    port (\n      clk   : in std_logic;\n      rst   : in std_logic;\n      en    : in std_logic := '1';\n      count : out unsigned(WIDTH - 1 downto 0)\n    );\n  end component counter;"}]}}}
