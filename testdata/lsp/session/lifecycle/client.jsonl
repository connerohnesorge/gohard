{"jsonrpc":"2.0","id":2,"method":"initialize","params":{"capabilities":{}}}
{"jsonrpc":"2.0","method":"initialized","params":{}}
{"jsonrpc":"1.0","id":3,"method":"gohard/what"}
{"jsonrpc":"2.0","id":4,"method":"gohard/unknown","params":{}}
