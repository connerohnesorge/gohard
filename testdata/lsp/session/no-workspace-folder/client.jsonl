# A client that names no workspace folder (#48): the folder of the
# first file opened (/work) becomes the project folder, so definition
# of "adder" finds the entity in adder.vhd, which is not open.
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"capabilities":{"general":{"positionEncodings":["utf-16","utf-8"]}}}}
{"jsonrpc":"2.0","method":"initialized","params":{}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///work/top.vhd","languageId":"vhdl","version":1,"text":"entity top is end;\n-- uses adder\n"}}}
{"jsonrpc":"2.0","id":2,"method":"textDocument/definition","params":{"textDocument":{"uri":"file:///work/top.vhd"},"position":{"line":1,"character":10}}}
{"jsonrpc":"2.0","id":99,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
