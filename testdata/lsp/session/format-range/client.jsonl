# Range formatting (#32) returns edits only inside the requested range,
# with the format.* keys of gohard.yaml (indent 4, upper-case keywords).
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":"file:///work","capabilities":{"general":{"positionEncodings":["utf-8"]}}}}
{"jsonrpc":"2.0","method":"initialized","params":{}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///work/top.vhd","languageId":"vhdl","version":1,"text":"entity top is\nport(a:in bit;\nb:out bit);\nend;\narchitecture rtl of top is\nsignal s:bit;\nbegin\ns<=a;\nb<=s;\nend;\n"}}}
# Lines 1 and 2 (zero-based) only: the ports, not the entity header or end.
{"jsonrpc":"2.0","id":2,"method":"textDocument/rangeFormatting","params":{"textDocument":{"uri":"file:///work/top.vhd"},"range":{"start":{"line":1,"character":0},"end":{"line":3,"character":0}},"options":{"tabSize":2,"insertSpaces":true}}}
# Part of line 7: the edit at "<=" is inside, the indentation is not.
{"jsonrpc":"2.0","id":3,"method":"textDocument/rangeFormatting","params":{"textDocument":{"uri":"file:///work/top.vhd"},"range":{"start":{"line":7,"character":1},"end":{"line":7,"character":5}},"options":{"tabSize":2,"insertSpaces":true}}}
# An empty range gets no edits.
{"jsonrpc":"2.0","id":4,"method":"textDocument/rangeFormatting","params":{"textDocument":{"uri":"file:///work/top.vhd"},"range":{"start":{"line":5,"character":3},"end":{"line":5,"character":3}},"options":{"tabSize":2,"insertSpaces":true}}}
# After an edit the range is formatted on the new text.
{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///work/top.vhd","version":2},"contentChanges":[{"range":{"start":{"line":8,"character":0},"end":{"line":8,"character":5}},"text":"   b  <=  s  ;"}]}}
{"jsonrpc":"2.0","id":5,"method":"textDocument/rangeFormatting","params":{"textDocument":{"uri":"file:///work/top.vhd"},"range":{"start":{"line":8,"character":0},"end":{"line":9,"character":0}},"options":{"tabSize":2,"insertSpaces":true}}}
{"jsonrpc":"2.0","id":99,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
